{{!
    @template core_form/element-template

    Template for the form element wrapper template.

    Context variables required for this template:
    * label
    * required
    * advanced
    * helpbutton
    * error
    * element
        * id
        * name
        * badges - optional list of short labels shown beside the label, set via
          MoodleQuickForm::set_field_badges()
        * lockedreason - optional explanation of why the element cannot be edited, set via
          MoodleQuickForm::set_locked_reason()

    Example context (json):
    {
        "label": "Course full name",
        "required": true,
        "advanced": false,
        "error": null,
        "element": {
            "wrapperid": "fitem_id_fullname",
            "id": "id_fullname",
            "name": "fullname",
            "badges": ["Site setting"],
            "lockedreason": "You do not have permission to change this setting."
        }
    }
}}
<div id="{{element.wrapperid}}" class="mb-3 row {{#error}}has-danger{{/error}} fitem {{#element.emptylabel}}femptylabel{{/element.emptylabel}} {{#advanced}}advanced{{/advanced}} {{{element.extraclasses}}} {{{element.parentclasses}}}" {{#element.groupname}}data-groupname="{{.}}"{{/element.groupname}}>
    <div class="col-md-3 col-form-label d-flex pb-0 pe-md-0">
        {{# label}}{{$ label }}
            {{^element.staticlabel}}
                <label id="{{element.id}}_label" class="d-inline word-break {{#element.hiddenlabel}}visually-hidden{{/element.hiddenlabel}}" for="{{element.id}}">
                    {{{label}}}
                </label>
            {{/element.staticlabel}}
            {{#element.staticlabel}}
                <span class="d-inline-block {{#element.hiddenlabel}}visually-hidden{{/element.hiddenlabel}}">
                    {{{label}}}
                </span>
            {{/element.staticlabel}}
        {{/ label }}{{/ label}}
        <div class="form-label-addon d-flex align-items-center align-self-start">
            {{#required}}
                <div class="text-danger align-self-start" title="{{#str}}required{{/str}}" aria-hidden="true">
                    <span class="form-required-marker"></span>
                </div>
            {{/required}}
            {{#element.badges}}
                <span class="badge ms-2 text-uppercase form-field-badge">{{.}}</span>
            {{/element.badges}}
        </div>
        <div class="form-label-help">{{{helpbutton}}}</div>
    </div>
    <div class="col-md-9 d-flex flex-wrap align-items-start felement" data-fieldtype="{{element.type}}">
        {{$ element }}
            <!-- Element goes here -->
        {{/ element }}
        {{#element.lockedreason}}
            <div class="form-locked-reason d-flex align-items-start w-100 mt-1 text-muted">
                <span class="me-1" aria-hidden="true">{{#pix}}t/locked, core{{/pix}}</span>
                <span>{{.}}</span>
            </div>
        {{/element.lockedreason}}
        <div class="form-control-feedback invalid-feedback" id="{{element.iderror}}" {{#error}} style="display: block;"{{/error}}>
            {{{error}}}
        </div>
    </div>
</div>
{{#js}}
require(['theme_boost/form-display-errors'], function(module) {
    module.enhance({{#quote}}{{element.id}}{{/quote}});
});
{{/js}}
